command=/usr/bin/heaviest-cpu-daemon
command_background="true"
pidfile="/run/heaviest.pid"
output_log="/var/log/heaviest.log"
error_log="/var/log/heaviest-error.log"

depend() {
    need localmount
    after bootmisc
}